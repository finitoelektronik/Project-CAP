{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/claude/cap-module-guard.ps1",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
